generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model app_user {
  id         String       @id @db.Uuid
  name       String
  email      String       @unique
  role       String       @default("user")
  password   String?
  steam_card steam_card[]
  tag        tag[]
}

model steam_card {
  id              String      @id @db.Uuid
  activation_code String      @unique(map: "unique_activation_code")
  barcode         String      @unique(map: "unique_barcode")
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  img_src         String?
  user_id         String      @db.Uuid
  tag_id          String?     @db.Uuid
  pack_id         String?     @db.Uuid
  errorCard       errorCard[]
  pack            pack?       @relation(fields: [pack_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pack")
  tag             tag?        @relation(fields: [tag_id], references: [id], onUpdate: NoAction, map: "fk_steam_card_tag")
  app_user        app_user    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_steam_card_user")

  @@index([tag_id])
  @@index([user_id, created_at], map: "steam_card_user_created_idx")
  @@index([created_at(sort: Desc)], map: "steam_card_created_at_idx")
  @@index([user_id, tag_id], map: "steam_card_user_tag_idx")
  @@index([pack_id], map: "steam_card_pack_id_idx")
}

model tag {
  id                 String           @id @db.Uuid
  name               String           @unique
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  userId             String?          @db.Uuid
  is_activated       Boolean          @default(false)
  is_visible_to_user Boolean          @default(true)
  approved_by_user   Boolean          @default(false)
  steam_card         steam_card[]
  activation_job     activation_job[]
  app_user           app_user?        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "tag_userid_idx")
}

model errorCard {
  id            String     @id @db.Uuid
  googleanswer  String?
  steam_card_id String     @db.Uuid
  steam_card    steam_card @relation(fields: [steam_card_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_steamcard")
}

model pack {
  id           String       @id @db.Uuid
  start_number String       @unique(map: "pack_start_number_unique")
  steam_card   steam_card[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model aras_scan_public_pack {
  id           String? @db.Uuid
  start_number String?

  @@ignore
}

model ean {
  id   String @id @db.Uuid
  code String @unique
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model magic_link {
  id         String   @id @db.Uuid
  start_at   DateTime @db.Timestamptz(6)
  end_at     DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([start_at, end_at], map: "magic_link_active_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model start_campaign {
  id         String   @id @db.Uuid
  tag_id     String   @db.Uuid
  start_at   DateTime @db.Timestamptz(6)
  end_at     DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

/// One "Activate" run for a tag. status: running | paused | cancelled | finished
model activation_job {
  id              String            @id @db.Uuid
  tag_id          String            @db.Uuid
  ean             String
  amount          Int /// euros (20 or 30)
  currency        String            @default("978")
  fallback_ean    String? /// on "invalid amount", retry the card with this EAN ...
  fallback_amount Int? /// ... and this amount (euros)
  status          String
  finish_at       DateTime          @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  started_at      DateTime?         @db.Timestamptz(6)
  ended_at        DateTime?         @db.Timestamptz(6)
  tag             tag               @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items           activation_item[]

  @@index([tag_id, created_at])
}

/// One card inside an activation_job. status: pending | sending | activated | already_active | failed | cancelled
model activation_item {
  id            String         @id @db.Uuid
  job_id        String         @db.Uuid
  steam_card_id String         @db.Uuid
  position      Int
  barcode       String
  status        String         @default("pending")
  ean           String?
  amount        Int?
  terminal_id   String?
  tx_id         String?
  result_text   String?
  attempts      Int            @default(0)
  last_response Json?
  updated_at    DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  job           activation_job @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([job_id, status, position])
  @@index([steam_card_id])
  @@index([updated_at, status])
}

/// History of barcode corrections (wrong scan -> real barcode) and the activation sent for it.
/// No foreign keys on purpose: the history stays even if a card or job is deleted.
model barcode_correction {
  id                 String   @id @db.Uuid
  steam_card_id      String   @db.Uuid
  old_barcode        String
  new_barcode        String
  pack_id            String?  @db.Uuid
  source             String /// pack_check | activation_retry
  activation_item_id String?  @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([steam_card_id])
  @@index([old_barcode])
  @@index([new_barcode])
}
