<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CardScan Admin Dashboard</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
      :root {
        --primary: #6262a6;
        --primary-dark: #4e4e85;
        --primary-light: #eef0f7;
        --text-dark: #1e293b;
        --text-gray: #64748b;
        --bg-body: #f1f5f9;
        --white: #ffffff;
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --sidebar-width: 260px;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Inter", sans-serif;
      }

      body {
        background-color: var(--bg-body);
        display: flex;
        min-height: 100vh;
      }

      /* --- SIDEBAR --- */
      .sidebar {
        width: var(--sidebar-width);
        background-color: var(--primary);
        color: var(--white);
        display: flex;
        flex-direction: column;
        position: fixed;
        height: 100vh;
        left: 0;
        top: 0;
        padding: 24px;
        z-index: 50;
      }

      .logo {
        font-size: 22px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 40px;
        letter-spacing: -0.5px;
      }

      .menu-label {
        font-size: 12px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 10px;
        font-weight: 600;
        letter-spacing: 0.5px;
      }

      .menu {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .menu li a {
        text-decoration: none;
        color: rgba(255, 255, 255, 0.8);
        padding: 12px 16px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.2s;
      }

      .menu li a:hover,
      .menu li a.active {
        background-color: rgba(255, 255, 255, 0.15);
        color: var(--white);
      }

      .menu li a i {
        width: 20px;
        text-align: center;
      }

      /* --- MAIN CONTENT --- */
      .main-wrapper {
        margin-left: var(--sidebar-width);
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      /* --- HEADER --- */
      header {
        background-color: var(--white);
        height: 70px;
        padding: 0 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: var(--shadow);
        position: sticky;
        top: 0;
        z-index: 40;
      }

      .search-bar {
        display: flex;
        align-items: center;
        background-color: var(--bg-body);
        padding: 10px 16px;
        border-radius: 8px;
        width: 350px;
        border: 1px solid transparent;
        transition: 0.2s;
      }

      .search-bar:focus-within {
        border-color: var(--primary);
        background-color: var(--white);
      }

      .search-bar i {
        color: var(--text-gray);
        margin-right: 10px;
      }

      .search-bar input {
        border: none;
        background: none;
        outline: none;
        width: 100%;
        font-size: 14px;
        color: var(--text-dark);
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .icon-wrapper {
        position: relative;
        cursor: pointer;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: 0.2s;
      }

      .icon-wrapper:hover {
        background-color: var(--bg-body);
        color: var(--primary);
      }

      .badge {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 8px;
        height: 8px;
        background-color: #ef4444;
        border-radius: 50%;
        border: 2px solid var(--white);
      }

      /* --- DASHBOARD CONTENT --- */
      .content {
        padding: 32px;
      }

      .page-title {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 24px;
      }

      /* Stat Cards */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
        margin-bottom: 32px;
      }

      .stat-card {
        background: var(--white);
        padding: 24px;
        border-radius: 12px;
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .stat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
      }

      .stat-title {
        color: var(--text-gray);
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
      }

      .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
      }

      .bg-purple {
        background: rgba(98, 98, 166, 0.1);
        color: var(--primary);
      }
      .bg-green {
        background: #dcfce7;
        color: #16a34a;
      }
      .bg-orange {
        background: #ffedd5;
        color: #ea580c;
      }
      .bg-red {
        background: #fee2e2;
        color: #dc2626;
      }

      .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-dark);
      }

      .stat-diff {
        font-size: 12px;
        margin-top: 8px;
        font-weight: 500;
      }

      .text-up {
        color: #16a34a;
      }
      .text-down {
        color: #dc2626;
      }

      /* Analytics Section */
      .analytics-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
      }

      .panel {
        background: var(--white);
        border-radius: 12px;
        box-shadow: var(--shadow);
        padding: 24px;
        display: flex;
        flex-direction: column;
      }

      .panel-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 20px;
      }

      /* --- CRITICAL FIX: Fixed Height Container for Chart --- */
      .chart-container {
        position: relative;
        height: 400px; /* Fixed height stops it from growing forever */
        width: 100%;
      }

      /* List Styling */
      .user-list {
        list-style: none;
        overflow-y: auto;
        max-height: 400px; /* Aligns with chart height */
      }

      .user-item {
        display: flex;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f1f5f9;
      }

      .user-item:last-child {
        border-bottom: none;
      }

      .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: var(--primary-light);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        margin-right: 12px;
      }

      .user-info h4 {
        font-size: 14px;
        color: var(--text-dark);
        margin-bottom: 2px;
      }

      .user-info p {
        font-size: 12px;
        color: var(--text-gray);
      }

      .scan-count {
        margin-left: auto;
        font-weight: 600;
        color: var(--primary);
        font-size: 14px;
      }
      /* --- NOTIFICATION UPDATES --- */

      /* Updated Badge to hold numbers */
      .badge {
        position: absolute;
        top: -2px;
        right: -2px;
        min-width: 18px;
        height: 18px;
        padding: 0 4px;
        background-color: #ef4444;
        border-radius: 10px;
        border: 2px solid var(--white);
        color: white;
        font-size: 10px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Dropdown Container */
      .notification-dropdown {
        display: none; /* Hidden by default */
        position: absolute;
        top: 55px;
        right: -10px; /* Aligns with the right edge of icon wrapper */
        width: 300px;
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1),
          0 4px 6px -2px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        z-index: 100;
        overflow: hidden;
        cursor: default; /* Reset cursor inside dropdown */
      }

      /* Show class for JS toggle */
      .notification-dropdown.active {
        display: block;
        animation: fadeIn 0.2s ease-out;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .notif-header {
        padding: 16px;
        font-weight: 600;
        font-size: 14px;
        color: var(--text-dark);
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .mark-read {
        font-size: 11px;
        color: var(--primary);
        cursor: pointer;
      }

      .notif-list {
        max-height: 300px;
        overflow-y: auto;
      }

      .notif-item {
        padding: 12px 16px;
        display: flex;
        gap: 12px;
        border-bottom: 1px solid #f1f5f9;
        transition: background 0.2s;
        cursor: pointer;
      }

      .notif-item:hover {
        background-color: #f8fafc;
      }

      .notif-item:last-child {
        border-bottom: none;
      }

      /* Notification Avatar */
      .notif-img {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid #e2e8f0;
      }

      .notif-content {
        flex: 1;
      }

      .notif-text {
        font-size: 13px;
        color: var(--text-gray);
        line-height: 1.4;
        margin-bottom: 4px;
      }

      .notif-text strong {
        color: var(--text-dark);
        font-weight: 600;
      }

      .notif-time {
        font-size: 11px;
        color: #94a3b8;
      }

      /* Responsive */
      @media (max-width: 1024px) {
        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .analytics-grid {
          grid-template-columns: 1fr; /* Stack chart and list on tablets */
        }
        .chart-container {
          height: 300px; /* Slightly smaller on tablets */
        }
      }

      @media (max-width: 768px) {
        .sidebar {
          display: none;
        }
        .main-wrapper {
          margin-left: 0;
        }
        .stats-grid {
          grid-template-columns: 1fr;
        }
        header {
          padding: 0 16px;
        }
        .search-bar {
          width: 200px;
        }
      }

      /* --- Activation overview --- */
      .act-table-wrap { width: 100%; overflow-x: auto; }
      .act-table { width: 100%; border-collapse: collapse; font-size: 13px; }
      .act-table th { text-align: left; padding: 10px 12px; background: #f8fafc; color: var(--text-gray); font-weight: 600; font-size: 11px; text-transform: uppercase; border-bottom: 1px solid #e2e8f0; white-space: nowrap; }
      .act-table td { padding: 12px; border-bottom: 1px solid #e2e8f0; color: var(--text-dark); white-space: nowrap; }
      .act-table .num { text-align: right; font-variant-numeric: tabular-nums; }
      .act-table a { color: var(--primary-dark); font-weight: 600; text-decoration: none; }
      .act-table a:hover { text-decoration: underline; }
      .act-bar { height: 8px; background: var(--bg-body); border-radius: 999px; overflow: hidden; display: flex; margin-bottom: 4px; }
      .act-bar > div { height: 100%; }
      .act-bar .ok { background: #16a34a; } .act-bar .al { background: #0d9488; } .act-bar .fl { background: #ef4444; } .act-bar .cx { background: #cbd5e1; }
      .act-pct { font-size: 11px; color: var(--text-gray); font-variant-numeric: tabular-nums; }
      .act-pill { display: inline-block; padding: 3px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; text-transform: uppercase; }
      .act-pill.running { background: #dbeafe; color: #1d4ed8; }
      .act-pill.paused { background: #fef3c7; color: #b45309; }
      .act-pill.finished { background: #dcfce7; color: #15803d; }
      .act-pill.cancelled { background: #f1f5f9; color: #64748b; }

      /* --- Weekly report --- */
      .rep-btn { background: var(--primary); color: #fff; border: none; border-radius: 8px; padding: 8px 14px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
      .rep-btn:hover { background: var(--primary-dark); }
      .rep-backdrop { display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.5); z-index: 200; align-items: flex-start; justify-content: center; padding: 40px 16px; overflow-y: auto; }
      .rep-modal { background: #fff; border-radius: 12px; width: 100%; min-width: 0; max-width: 1100px; box-shadow: 0 20px 40px rgba(0,0,0,0.2); }
      .rep-head { display: flex; justify-content: space-between; align-items: flex-start; padding: 20px 24px 12px; }
      .rep-head h3 { font-size: 18px; color: var(--text-dark); }
      .rep-sub { font-size: 12px; color: var(--text-gray); margin-top: 4px; }
      .rep-x { background: none; border: none; font-size: 18px; color: var(--text-gray); cursor: pointer; padding: 4px 8px; }
      .rep-weekbar { display: flex; align-items: center; gap: 8px; padding: 12px 24px; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; flex-wrap: wrap; background: #f8fafc; }
      .rep-nav { width: 34px; height: 34px; border-radius: 8px; border: 1px solid #e2e8f0; background: #fff; cursor: pointer; color: var(--text-dark); }
      .rep-nav:disabled { opacity: 0.4; cursor: default; }
      .rep-week { font-weight: 700; color: var(--text-dark); min-width: 230px; text-align: center; font-variant-numeric: tabular-nums; }
      .rep-link { background: none; border: none; color: var(--primary-dark); font-weight: 600; font-size: 13px; cursor: pointer; padding: 6px 8px; border-radius: 6px; }
      .rep-link:hover { background: var(--primary-light); }
      .rep-body { padding: 20px 24px 24px; }
      .rep-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin-bottom: 20px; }
      .rep-tile { background: #f8fafc; border-radius: 10px; padding: 12px 14px; }
      .rep-tile .v { font-size: 24px; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--text-dark); }
      .rep-tile .l { font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-gray); }
      .rep-tile .h { font-size: 12px; color: var(--text-gray); margin-top: 2px; }
      .rep-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
      .rep-grid2 > div { min-width: 0; overflow-x: auto; }
      @media (max-width: 800px) { .rep-grid2 { grid-template-columns: 1fr; } .rep-head, .rep-weekbar, .rep-body { padding-left: 16px; padding-right: 16px; } }
      .rep-h { font-size: 13px; font-weight: 700; color: var(--text-dark); margin-bottom: 8px; }
      .rep-table { width: 100%; border-collapse: collapse; font-size: 13px; }
      .rep-table th { text-align: left; padding: 8px 10px; background: #f8fafc; color: var(--text-gray); font-size: 11px; text-transform: uppercase; font-weight: 600; border-bottom: 1px solid #e2e8f0; white-space: nowrap; }
      .rep-table td { padding: 9px 10px; border-bottom: 1px solid #f1f5f9; white-space: nowrap; }
      .rep-table .num { text-align: right; font-variant-numeric: tabular-nums; }
      .rep-table tfoot td { font-weight: 700; border-top: 2px solid #e2e8f0; border-bottom: none; }
      .rep-table a { color: var(--primary-dark); font-weight: 600; text-decoration: none; }
      .rep-scroll { overflow-x: auto; }
      .rep-daybar { display: inline-block; height: 8px; background: #16a34a; border-radius: 4px; vertical-align: middle; }
      .rep-empty { text-align: center; color: var(--text-gray); padding: 40px 0; }
    </style>
  </head>
