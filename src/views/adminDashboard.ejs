    <div id="reportModal" class="rep-backdrop" onclick="if (event.target === this) closeWeeklyReport()">
      <div class="rep-modal" role="dialog" aria-modal="true" aria-labelledby="repTitle">
        <div class="rep-head">
          <div>
            <h3 id="repTitle">Weekly activation report</h3>
            <div class="rep-sub">Mon–Sun, Berlin time · use it to check the Monday invoice</div>
          </div>
          <button class="rep-x" onclick="closeWeeklyReport()" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="rep-weekbar">
          <button class="rep-nav" id="repPrev" aria-label="Previous week"><i class="fas fa-chevron-left"></i></button>
          <div class="rep-week" id="repWeek">…</div>
          <button class="rep-nav" id="repNext" aria-label="Next week"><i class="fas fa-chevron-right"></i></button>
          <button class="rep-link" id="repLast">Last week</button>
          <button class="rep-link" id="repThis">This week</button>
          <span style="flex:1"></span>
          <button class="rep-btn" id="repCsv"><i class="fas fa-file-csv"></i> Download CSV</button>
        </div>
        <div class="rep-body" id="repBody"></div>
      </div>
    </div>
    <script>
      (function () {
        var ADMIN_BASE = "/a26ae3e19a140048efd2";
        var data = <%- JSON.stringify(typeof activation !== "undefined" ? activation : null).replace(/</g, "\\u003c") %>;

        function esc(v) {
          return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
          });
        }
        function num(n) { return Number(n || 0).toLocaleString("de-DE"); }
        function fmt(d) {
          return d ? new Date(d).toLocaleString("de-DE", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }) : "—";
        }

        function card(title, icon, color, value, sub) {
          return '<div class="stat-card"><div class="stat-header"><span class="stat-title">' + title +
            '</span><div class="stat-icon ' + color + '"><i class="fas ' + icon + '"></i></div></div>' +
            '<div class="stat-value">' + value + '</div><div class="stat-diff" style="color: var(--text-gray);">' + sub + '</div></div>';
        }

        function render() {
          if (!data) return;
          var t = data.totals;
          document.getElementById("activationStats").innerHTML =
            card("Running Activations", "fa-cog", "bg-purple", num(t.runningJobs),
              (t.pausedJobs ? num(t.pausedJobs) + " paused · " : "") + num(t.pendingCards) + " cards waiting") +
            card("Activated Today", "fa-check-circle", "bg-green", num(t.today.activated), "since 00:00") +
            card("Failed Today", "fa-times-circle", "bg-red", num(t.today.failed), "fix them in the job's Details") +
            card("Activated All Time", "fa-id-card", "bg-orange", num(t.allTime.activated), "cards");

          var rows = data.jobs.map(function (j) {
            var c = j.counts, tot = j.total || 1;
            var processed = c.activated + c.already_active + c.failed + c.cancelled;
            var w = function (n) { return (n / tot * 100).toFixed(2) + "%"; };
            return '<tr>' +
              '<td><a href="' + ADMIN_BASE + '/download/' + encodeURIComponent(j.tagId) + '">' + esc(j.tagName) + '</a></td>' +
              '<td><span class="act-pill ' + esc(j.status) + '">' + esc(j.status) + '</span></td>' +
              '<td>' + esc(j.ean) + ' · <b>' + esc(j.amount) + ' €</b></td>' +
              '<td><div class="act-bar"><div class="ok" style="width:' + w(c.activated) + '"></div><div class="al" style="width:' + w(c.already_active) +
                '"></div><div class="fl" style="width:' + w(c.failed) + '"></div><div class="cx" style="width:' + w(c.cancelled) + '"></div></div>' +
                '<div class="act-pct">' + num(processed) + ' / ' + num(j.total) + ' · ' + Math.round(processed / tot * 100) + '%</div></td>' +
              '<td class="num" style="color:#15803d">' + num(c.activated + c.already_active) + '</td>' +
              '<td class="num" style="color:' + (c.failed ? "#b91c1c" : "inherit") + '">' + num(c.failed) + '</td>' +
              '<td class="num">' + num(c.pending + c.sending) + '</td>' +
              '<td>' + fmt(j.created_at) + '</td>' +
              '<td>' + (j.ended_at ? fmt(j.ended_at) : fmt(j.finish_at)) + '</td>' +
              '</tr>';
          }).join("");
          document.getElementById("actRows").innerHTML = rows ||
            '<tr><td colspan="9" style="text-align:center; color: var(--text-gray); padding: 20px;">No activations yet.</td></tr>';
          document.getElementById("actUpdated").textContent = "updated " + new Date().toLocaleTimeString("de-DE");
        }

        render();
        setInterval(function () {
          if (document.hidden) return;
          fetch(ADMIN_BASE + "/api/activation-overview", { headers: { Accept: "application/json" } })
            .then(function (r) { return r.json(); })
            .then(function (d) { if (d && d.success) { data = d; render(); } })
            .catch(function () {});
        }, 15000);
      })();
    </script>

    <script>
      (function () {
        var ADMIN_BASE = "/a26ae3e19a140048efd2";
        var modal = document.getElementById("reportModal");
        var body = document.getElementById("repBody");
        var report = null;

        function esc(v) {
          return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
          });
        }
        function num(n) { return Number(n || 0).toLocaleString("de-DE"); }
        function dmy(d) { var p = d.split("-"); return p[2] + "." + p[1] + "." + p[0]; }
        function dt(d) { return d ? new Date(d).toLocaleString("de-DE", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }) : "—"; }
        function pct(x) { return x == null ? "—" : (Math.floor(x * 1000) / 10).toFixed(1).replace(".", ",") + " %"; }
        var DAY = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

        function load(week) {
          body.innerHTML = '<div class="rep-empty"><i class="fas fa-spinner fa-spin"></i> Loading…</div>';
          fetch(ADMIN_BASE + "/api/activation-report" + (week ? "?week=" + encodeURIComponent(week) : ""), { headers: { Accept: "application/json" } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              if (!d || !d.success) throw new Error((d && d.message) || "failed");
              report = d;
              render();
            })
            .catch(function (e) { body.innerHTML = '<div class="rep-empty">Could not load the report: ' + esc(e.message) + '</div>'; });
        }

        function tile(label, value, hint) {
          return '<div class="rep-tile"><div class="l">' + label + '</div><div class="v">' + value + '</div>' + (hint ? '<div class="h">' + hint + '</div>' : "") + '</div>';
        }

        function render() {
          var r = report, t = r.totals;
          document.getElementById("repWeek").textContent = "Week " + Number(r.week.split("-W")[1]) + " · " + dmy(r.from) + " – " + dmy(r.to);
          document.getElementById("repNext").disabled = r.isCurrentOrFuture;

          var diff = t.activated - t.prevWeekActivated;
          var diffTxt = t.prevWeekActivated ? (diff >= 0 ? "+" : "−") + num(Math.abs(diff)) + " vs previous week" : "previous week: 0";

          var html = '<div class="rep-tiles">' +
            tile("Activated", num(t.activated), diffTxt) +
            tile("Already active", num(t.already_active), "sent, card was already on") +
            tile("Failed", num(t.failed), "still failed now") +
            tile("Success rate", pct(t.successRate), "activated + already active") +
            tile("Tags", num(t.tags), "with activations this week") +
            tile("Terminals used", num(t.terminals), "") +
            (t.pendingNow ? tile("Still pending", num(t.pendingNow), "in these tags' jobs, right now") : "") +
            '</div>';

          if (r.isCurrentOrFuture) {
            html += '<p style="font-size:12px; color:#b45309; margin:-8px 0 16px;"><i class="fas fa-info-circle"></i> This week is not over yet; numbers keep growing.</p>';
          }

          if (!r.tags.length) {
            body.innerHTML = html + '<div class="rep-empty">No activations in this week.</div>';
            return;
          }

          // per tag
          html += '<div class="rep-h">Tags activated this week</div><div class="rep-scroll"><table class="rep-table"><thead><tr>' +
            '<th>Tag</th><th>Owner</th><th>EAN</th><th>Job</th><th class="num">Activated</th><th class="num">Already active</th>' +
            '<th class="num">Failed</th><th class="num">Pending now</th><th>First</th><th>Last</th></tr></thead><tbody>' +
            r.tags.map(function (g) {
              return '<tr><td><a href="' + ADMIN_BASE + '/download/' + encodeURIComponent(g.tagId) + '">' + esc(g.tagName) + '</a></td>' +
                '<td>' + esc(g.owner || "—") + '</td><td>' + esc(g.eans.join(", ")) + '</td>' +
                '<td><span class="act-pill ' + esc(g.jobStatus) + '">' + esc(g.jobStatus) + '</span></td>' +
                '<td class="num" style="color:#15803d; font-weight:600">' + num(g.activated) + '</td>' +
                '<td class="num">' + num(g.already_active) + '</td>' +
                '<td class="num" style="color:' + (g.failed ? "#b91c1c" : "inherit") + '">' + num(g.failed) + '</td>' +
                '<td class="num">' + (g.pendingNow ? num(g.pendingNow) : "—") + '</td>' +
                '<td>' + dt(g.first_at) + '</td><td>' + dt(g.last_at) + '</td></tr>';
            }).join("") +
            '</tbody><tfoot><tr><td colspan="4">Total</td><td class="num">' + num(t.activated) + '</td><td class="num">' + num(t.already_active) +
            '</td><td class="num">' + num(t.failed) + '</td><td class="num">' + (t.pendingNow ? num(t.pendingNow) : "—") + '</td><td colspan="2"></td></tr></tfoot></table></div>';

          // per day + per EAN + reasons
          var maxDay = Math.max.apply(null, r.days.map(function (d) { return d.activated; }).concat([1]));
          html += '<div class="rep-grid2" style="margin-top:20px;"><div><div class="rep-h">By day</div><table class="rep-table"><thead><tr><th>Day</th><th class="num">Activated</th><th></th><th class="num">Failed</th></tr></thead><tbody>' +
            r.days.map(function (d, i) {
              return '<tr><td>' + DAY[i] + ' ' + dmy(d.date).slice(0, 6) + '</td><td class="num">' + num(d.activated + d.already_active) + '</td>' +
                '<td style="width:40%"><span class="rep-daybar" style="width:' + ((d.activated + d.already_active) / maxDay * 100).toFixed(1) + '%"></span></td>' +
                '<td class="num">' + (d.failed ? num(d.failed) : "—") + '</td></tr>';
            }).join("") + '</tbody></table></div>';

          html += '<div><div class="rep-h">By EAN</div><table class="rep-table"><thead><tr><th>EAN</th><th class="num">Activated</th><th class="num">Already active</th><th class="num">Failed</th></tr></thead><tbody>' +
            r.byEan.map(function (e) {
              return '<tr><td>' + esc(e.ean) + '</td><td class="num">' + num(e.activated) + '</td><td class="num">' + num(e.already_active) + '</td><td class="num">' + num(e.failed) + '</td></tr>';
            }).join("") + '</tbody></table>';

          html += '<div class="rep-h" style="margin-top:20px;">Why cards failed</div>' + (r.reasons.length
            ? '<table class="rep-table"><tbody>' + r.reasons.map(function (x) {
                return '<tr><td style="white-space:normal">' + esc(x.reason) + '</td><td class="num">' + num(x.n) + '</td></tr>';
              }).join("") + '</tbody></table>'
            : '<div style="font-size:13px; color: var(--text-gray);">No failures this week.</div>') + '</div></div>';

          body.innerHTML = html;
        }

        function downloadCsv() {
          if (!report) return;
          var q = function (v) { v = String(v == null ? "" : v); return /[",;\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; };
          var lines = [["Tag", "Owner", "EAN", "Job status", "Activated", "Already active", "Failed", "Pending now", "First", "Last"].join(";")];
          report.tags.forEach(function (g) {
            lines.push([g.tagName, g.owner || "", g.eans.join(" "), g.jobStatus, g.activated, g.already_active, g.failed, g.pendingNow, dt(g.first_at), dt(g.last_at)].map(q).join(";"));
          });
          var t = report.totals;
          lines.push(["Total", "", "", "", t.activated, t.already_active, t.failed, t.pendingNow, "", ""].map(q).join(";"));
          var blob = new Blob(["\ufeff" + lines.join("\n")], { type: "text/csv;charset=utf-8" });
          var a = document.createElement("a");
          a.href = URL.createObjectURL(blob);
          a.download = "activations-" + report.week + ".csv";
          document.body.appendChild(a); a.click(); a.remove();
          URL.revokeObjectURL(a.href);
        }

        window.openWeeklyReport = function () {
          modal.style.display = "flex";
          document.body.style.overflow = "hidden";
          load(null); // server default: last week
        };
        window.closeWeeklyReport = function () {
          modal.style.display = "none";
          document.body.style.overflow = "";
        };
        document.getElementById("repPrev").onclick = function () { if (report) load(report.prevWeek); };
        document.getElementById("repNext").onclick = function () { if (report && !report.isCurrentOrFuture) load(report.nextWeek); };
        document.getElementById("repLast").onclick = function () { load(null); };
        document.getElementById("repThis").onclick = function () { if (report) load(report.thisWeek); };
        document.getElementById("repCsv").onclick = downloadCsv;
        document.addEventListener("keydown", function (e) { if (e.key === "Escape" && modal.style.display === "flex") window.closeWeeklyReport(); });
      })();
    </script>
  </body>
</html>
